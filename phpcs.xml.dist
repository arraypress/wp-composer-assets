<?xml version="1.0"?>
<ruleset name="wp-composer-assets">
    <description>
        The WordPress sniffs worth enforcing here.

        Deliberately not the full WordPress standard: most of what that adds is
        formatting this codebase consistently does differently, short array
        syntax above all. A wall of noise nobody reads is how a real finding
        gets lost. What is left is the part that catches defects rather than
        preferences.
    </description>

    <file>src</file>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.3-"/>

    <!--
        No runtime code interpreter, anywhere that ships. It is a construct
        WordPress security scanners report on sight, and a plugin's vendor
        directory does get scanned: by WordPress.org on submission, and by
        security plugins on the live site. The sniff is only a warning by
        default, and a warning does not fail CI.
    -->
    <rule ref="Squiz.PHP.Eval">
        <type>error</type>
    </rule>

</ruleset>
